<TargetEndpoint name="default">
  <Description>Claude backend. PoC: Anthropic API direct. Swap URL + backend-auth steps for Vertex/Bedrock.</Description>
  <PreFlow name="PreFlow">
    <Request>
      <!-- Backend leg only: read the Anthropic key from an encrypted KVM and inject it.
           The end-user never sees this key; the client Authorization header is removed. -->
      <Step><Name>KVM-GetAnthropicKey</Name></Step>
      <Step><Name>AM-InjectBackendAuth</Name></Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <URL>https://api.anthropic.com/v1</URL>
  </HTTPTargetConnection>
</TargetEndpoint>

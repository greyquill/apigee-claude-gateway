<VerifyJWT name="VJ-VerifyIdpToken">
  <DisplayName>Verify customer-IdP JWT (option C: non-Google federation)</DisplayName>
  <!-- Validates a JWT minted by the customer's OWN IdP (Okta / Entra ID / Auth0 / Keycloak).
       Zero Google identity in the end-user path. Issuer, audience and JWKS come from the
       'idp' property set (proxy/apigee/apiproxy/resources/properties/idp.properties) so the
       same bundle points at any customer IdP by config, not code. -->
  <Algorithm>RS256</Algorithm>
  <Source>request.header.authorization.bearer</Source>
  <PublicKey>
    <JWKS uri="{propertyset.idp.jwks_uri}"/>
  </PublicKey>
  <Issuer>{propertyset.idp.issuer}</Issuer>
  <Audience>{propertyset.idp.audience}</Audience>
  <!-- Surface useful claims for principal resolution, quota keying and audit. -->
  <AdditionalClaims>
    <Claim name="scope" required="false"/>
    <Claim name="tier" required="false"/>
  </AdditionalClaims>
</VerifyJWT>

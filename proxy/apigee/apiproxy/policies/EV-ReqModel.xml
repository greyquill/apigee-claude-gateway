<ExtractVariables name="EV-ReqModel">
  <DisplayName>Extract requested model</DisplayName>
  <!-- Pull the model id from the request body so the gateway can enforce an allow-list. -->
  <Source>request</Source>
  <JSONPayload>
    <Variable name="model"><JSONPath>$.model</JSONPath></Variable>
  </JSONPayload>
  <VariablePrefix>gw</VariablePrefix>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>

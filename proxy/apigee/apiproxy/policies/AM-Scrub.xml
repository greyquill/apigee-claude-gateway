<AssignMessage name="AM-Scrub">
  <DisplayName>Strip backend/debug headers from user response</DisplayName>
  <Remove>
    <Headers>
      <Header name="x-api-key"/>
      <Header name="anthropic-organization-id"/>
      <Header name="request-id"/>
    </Headers>
  </Remove>
  <Set>
    <Headers>
      <Header name="X-Governed-By">apigee-claude-gateway</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>

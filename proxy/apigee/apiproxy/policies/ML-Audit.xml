<MessageLogging name="ML-Audit">
  <DisplayName>Audit log (everything is tracked)</DisplayName>
  <!-- Structured audit line per call. Ship to Cloud Logging, then sink to BigQuery / SIEM.
       Swap <CloudLogging> for <Syslog> if logging off-GCP. No secrets are logged. -->
  <CloudLogging>
    <LogName>projects/{organization.name}/logs/claude-gateway-audit</LogName>
    <Message contentType="application/json">{
      "ts": "{system.timestamp}",
      "request_id": "{messageid}",
      "principal": "{gw.principal}",
      "auth_method": "{gw.auth_method}",
      "issuer": "{gw.issuer}",
      "tier": "{gw.tier}",
      "model": "{claude.usage.model}",
      "input_tokens": "{claude.usage.input_tokens}",
      "output_tokens": "{claude.usage.output_tokens}",
      "cache_creation_tokens": "{claude.usage.cache_creation_input_tokens}",
      "cache_read_tokens": "{claude.usage.cache_read_input_tokens}",
      "status": "{response.status.code}",
      "path": "{proxy.pathsuffix}"
    }</Message>
    <ResourceType>global</ResourceType>
  </CloudLogging>
</MessageLogging>

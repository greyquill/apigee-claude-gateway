<StatisticsCollector name="SC-Tokens">
  <DisplayName>Record token usage into Analytics</DisplayName>
  <Statistics>
    <Statistic name="input_tokens" ref="claude.usage.input_tokens" type="integer">0</Statistic>
    <Statistic name="output_tokens" ref="claude.usage.output_tokens" type="integer">0</Statistic>
    <Statistic name="model" ref="claude.usage.model" type="string">unknown</Statistic>
    <Statistic name="principal" ref="gw.principal" type="string">unknown</Statistic>
    <Statistic name="auth_method" ref="gw.auth_method" type="string">unknown</Statistic>
    <Statistic name="tier" ref="gw.tier" type="string">default</Statistic>
  </Statistics>
</StatisticsCollector>

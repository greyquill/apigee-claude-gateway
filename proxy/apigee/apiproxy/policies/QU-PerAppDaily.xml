<Quota name="QU-PerAppDaily">
  <DisplayName>Per-principal daily quota</DisplayName>
  <!-- Keyed on the unified principal (API-key client_id OR JWT subject) so quota works for
       both auth paths. Per-tier override via the 'gw.tier'-driven attribute; default 1000/day. -->
  <Allow count="1000"/>
  <Interval>1</Interval>
  <TimeUnit>day</TimeUnit>
  <Identifier ref="gw.principal"/>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
</Quota>

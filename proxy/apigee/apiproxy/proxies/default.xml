<ProxyEndpoint name="default">
  <Description>End-user facing endpoint. No Google login required.</Description>
  <HTTPProxyConnection>
    <BasePath>/claude/v1</BasePath>
  </HTTPProxyConnection>

  <PreFlow name="PreFlow">
    <Request>
      <!-- Dual non-Google auth. If the caller sends a Bearer token, verify it as a
           customer-IdP JWT (option C); otherwise expect an Apigee API key (option A).
           Either way: no Google login in the end-user path. -->
      <Step>
        <Name>EV-BearerToken</Name>
        <Condition>request.header.authorization != null</Condition>
      </Step>
      <Step>
        <Name>VJ-VerifyIdpToken</Name>
        <Condition>request.header.authorization != null</Condition>
      </Step>
      <Step>
        <Name>AM-PrincipalFromJwt</Name>
        <Condition>request.header.authorization != null</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyKey</Name>
        <Condition>request.header.authorization = null</Condition>
      </Step>
      <Step>
        <Name>AM-PrincipalFromKey</Name>
        <Condition>request.header.authorization = null</Condition>
      </Step>
      <!-- Governance: enforce non-streaming, then the model allow-list. -->
      <Step><Name>EV-ReqModel</Name></Step>
      <Step>
        <Name>RF-StreamingNotAllowed</Name>
        <Condition>gw.stream = "true"</Condition>
      </Step>
      <Step>
        <Name>RF-ModelNotAllowed</Name>
        <Condition>(gw.model != "claude-opus-4-8") and (gw.model != "claude-sonnet-4-6") and (gw.model != "claude-haiku-4-5")</Condition>
      </Step>
      <Step><Name>SA-SmoothBurst</Name></Step>
      <Step><Name>QU-PerAppDaily</Name></Step>
      <Step><Name>AM-SetTarget</Name></Step>
    </Request>
    <Response/>
  </PreFlow>

  <Flows>
    <Flow name="Messages">
      <Description>Anthropic Messages API</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/messages") and (request.verb = "POST")</Condition>
      <Request/>
      <Response/>
    </Flow>
  </Flows>

  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step><Name>EV-Usage</Name></Step>
      <Step><Name>AM-Scrub</Name></Step>
      <Step><Name>SC-Tokens</Name></Step>
      <Step><Name>ML-Audit</Name></Step>
    </Response>
  </PostFlow>

  <RouteRule name="toClaude">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>

  <DefaultFaultRule name="default-fault">
    <Step>
      <Name>RF-AuthError</Name>
      <Condition>(fault.name = "InvalidApiKey") or (fault.name = "InvalidApiKeyForGivenResource") or (fault.name = "FailedToResolveAPIKey") or (fault.name Matches "*JWT*") or (fault.name = "InvalidToken")</Condition>
    </Step>
    <AlwaysEnforce>true</AlwaysEnforce>
  </DefaultFaultRule>
</ProxyEndpoint>
